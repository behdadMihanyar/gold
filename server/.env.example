# Copy to .env and adjust.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://gold:gold@localhost:5432/gold

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (only needed if the frontend
# is served from a different origin than the API; the Vite dev proxy avoids this).
CORS_ORIGINS=http://localhost:5173

# Session cookie is HTTPS-only in production. Set to false while the site
# is served over plain http:// (e.g. by IP, before adding a domain + SSL).
# COOKIE_SECURE=false

# Public sign-up is off by default — create staff accounts with `npm run user:create`.
ALLOW_SIGNUP=false

# Key for the gold/currency prices from brsapi.ir (a free key is used if unset).
# BRSAPI_KEY=
