# Copy to .env and adjust.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://gold:gold@localhost:5432/gold

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (only needed if the frontend
# is served from a different origin than the API; the Vite dev proxy avoids this).
CORS_ORIGINS=http://localhost:5173

# Public sign-up is off by default — create staff accounts with `npm run user:create`.
ALLOW_SIGNUP=false
